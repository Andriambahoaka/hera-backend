# Copy to .env and fill in. Never commit .env.
# The API validates these at startup (src/core/config/env.ts) and refuses to
# start in production if a required one is missing.

# --- App ---
NODE_ENV=production
PORT=3000
APP_DOMAIN=https://api.example.com
# Comma-separated. Empty = every origin allowed (warning in production).
CORS_ORIGINS=https://app.example.com

# --- Database ---
# Docker Compose: use the least-privilege app user, NOT the root user.
# Generate passwords with: openssl rand -hex 24   (hex avoids URL-encoding issues)
MONGO_URI=mongodb://hera_app:CHANGE_ME@mongo:27017/hera_db?authSource=hera_db&replicaSet=rs0

# --- Auth secrets (min 32 chars, all different) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
RESET_PASSWORD_SECRET=CHANGE_ME
MASTER_ADMIN_KEY=CHANGE_ME
MOBILE_API_KEY=CHANGE_ME

# --- Firebase (push notifications) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; newlines as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# --- Cloudinary (profile images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Brevo SMTP (emails) ---
# Brevo: API key (used when set, HTTPS) or SMTP credentials.
BREVO_API_KEY=
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_EMAIL_SENDER=noreply@example.com

# --- Dolynk (alarm devices) ---
DOLYNK_PRODUCT_ID=
DOLYNK_ACCESS_KEY=
DOLYNK_SECRET_ACCESS_KEY=
