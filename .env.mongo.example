# Copy to .env.mongo (next to docker-compose.yml). Never commit .env.mongo.
# Only the mongo container reads this file; the api never sees root credentials.

# Root user. On a FRESH volume it is created automatically.
# On an EXISTING volume these are ignored by the image: create the user by hand
# (see docs/runbooks/mongo-hardening.md), with exactly these values.
MONGO_INITDB_ROOT_USERNAME=hera_root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME

# Shared key for replica set members. Generate with:
#   openssl rand -base64 756 | tr -d '\n'
MONGO_REPLICA_KEY=CHANGE_ME
